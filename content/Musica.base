filters:
  and:
    - note.tipo == "album"
properties:
  file.name:
    displayName: Título
  note.year:
    displayName: Año
  note.autor:
    displayName: Artista
  note.nota:
    displayName: Nota
  note.estado:
    displayName: Estado
  note.favoritas:
    displayName: Tus canciones
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: nota
        direction: DESC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 1
  - type: table
    name: Tabla
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
      - note.estado
      - note.favoritas
    sort:
      - property: nota
        direction: DESC
    summaries:
      nota: Average
  - type: cards
    name: Favoritos
    filters:
      and:
        - note.favorito == true
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: nota
        direction: DESC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 1
