filters:
  and:
    - note.tipo == "juego"
properties:
  note.year:
    displayName: Año
  note.autor:
    displayName: Estudio
  note.nota:
    displayName: Nota
  note.estado:
    displayName: Estado
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - autor
      - year
      - nota
    sort:
      - property: nota
        direction: DESC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  - type: table
    name: Tabla
    order:
      - file.name
      - autor
      - year
      - nota
      - estado
    sort:
      - property: nota
        direction: DESC
    summaries:
      nota: Average
  - type: cards
    name: Solo favoritos
    filters:
      and:
        - note.favorito == true
    order:
      - file.name
      - autor
      - year
      - nota
    sort:
      - property: nota
        direction: DESC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
