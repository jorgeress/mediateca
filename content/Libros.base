filters:
  and:
    - note.tipo == "libro"
properties:
  file.name:
    displayName: Título
  note.year:
    displayName: Año
  note.autor:
    displayName: Autor
  note.nota:
    displayName: Nota
  note.estado:
    displayName: Estado
views:
  - type: cards
    name: Galería
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: nota
        direction: DESC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
  - type: table
    name: Tabla
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
      - note.estado
    sort:
      - property: nota
        direction: DESC
    summaries:
      nota: Average
  - type: cards
    name: Solo favoritos
    filters:
      and:
        - note.favorito == true
    order:
      - file.name
      - note.autor
      - note.year
      - note.nota
    sort:
      - property: nota
        direction: DESC
    image: note.portada
    cardSize: 220
    imageAspectRatio: 0.67
